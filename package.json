{
  "name": "renovate-config",
  "private": true,
  "scripts": {
    "check": "run-p check:*",
    "check:format": "prettier --check .",
    "check:markdown": "markdownlint-cli2 --config node_modules/lint-config/base.markdownlint-cli2.jsonc \"**/*.md\"",
    "check:package-json": "npmPkgJsonLint --configFile node_modules/lint-config/base.npmpackagejsonlintrc.json \"**/package.json\"",
    "check:renovate": "bunx --package renovate renovate-config-validator default.json renovate.json",
    "check:secrets": "secretlint --secretlintrc node_modules/lint-config/base.secretlintrc.json --secretlintignore node_modules/lint-config/base.secretlintignore \"**/*\"",
    "check:spell": "cspell --no-progress \"**\""
  },
  "devDependencies": {
    "lint-config": "github:takudev-works/lint-config#9b0def7"
  },
  "prettier": "lint-config/base.prettierrc.json"
}
