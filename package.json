{
  "name": "renovate-config",
  "private": true,
  "scripts": {
    "validate": "run-p validate:*",
    "validate:format": "prettier --check .",
    "validate:markdown": "markdownlint-cli2 --config node_modules/dev-config/base.markdownlint-cli2.jsonc \"**/*.md\"",
    "validate:package-json": "npmPkgJsonLint --configFile node_modules/dev-config/base.npmpackagejsonlintrc.json \"**/package.json\"",
    "validate:renovate": "bunx --package renovate renovate-config-validator default.json renovate.json",
    "validate:secrets": "secretlint --secretlintrc node_modules/dev-config/base.secretlintrc.json --secretlintignore node_modules/dev-config/base.secretlintignore \"**/*\"",
    "validate:spell": "cspell --no-progress \"**\""
  },
  "devDependencies": {
    "dev-config": "github:takudev-works/dev-config#v4.0.0"
  },
  "prettier": "dev-config/base.prettierrc.json"
}
